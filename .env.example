PORT=7860
RUST_LOG=backend=info,tower_http=info

ADMIN_EMAIL=admin@example.com
# Preferred: set ADMIN_PASSWORD_HASH to an Argon2id PHC string and leave ADMIN_PASSWORD unset.
# Accepted hashes use Argon2id v19 with m=19456-65536 KiB, t=2-4, p=1-4, and 16-64 output bytes.
ADMIN_PASSWORD_HASH=
# Compatibility fallback only. This documented placeholder is intentionally rejected at startup.
ADMIN_PASSWORD=change-this-admin-password
# This documented placeholder is also intentionally rejected; replace it with a unique random secret.
ADMIN_SESSION_SECRET=change-this-to-a-unique-random-secret-of-32-or-more-characters
ADMIN_SESSION_ISSUER=portfolio-backend
ADMIN_SESSION_AUDIENCE=portfolio-admin
# Increment this value to revoke every existing admin token.
ADMIN_SESSION_VERSION=1
ADMIN_SESSION_SECONDS=3600

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:7860,https://chamirahashan.tech,https://www.chamirahashan.tech,https://chamira-hashan-portfolio.pages.dev
# Enable only when the app is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
# Read the client address from exactly this header when proxy trust is enabled.
TRUSTED_PROXY_HEADER=x-forwarded-for

PORTFOLIO_DATA_DIR=./data
# Optional first-start JSON seed only; later writes go to PORTFOLIO_DATA_DIR.
PORTFOLIO_PROFILE_JSON=
# Combined public-media quota: 25 MiB through 10 GiB; default 512 MiB.
MAX_MEDIA_STORAGE_BYTES=536870912
# Serves /api-docs/openapi.json when enabled. Keep disabled in production unless needed.
ENABLE_API_DOCS=false
